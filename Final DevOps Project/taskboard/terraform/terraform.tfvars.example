# Copy to terraform.tfvars and adjust. terraform.tfvars is gitignored, so no
# real values are ever committed.
# Name: Hemang | Enrollment number: 24bcs10209

aws_region          = "ap-south-1"
project             = "taskboard"

# true  = LocalStack (free, local, no AWS account)
# false = real AWS  (billable - EKS control plane is ~$0.10/hour plus nodes)
use_localstack      = true

vpc_cidr            = "10.30.0.0/16"
public_subnet_cidrs = ["10.30.1.0/24", "10.30.2.0/24"]

cluster_version     = "1.31"
node_instance_type  = "t3.medium"
node_desired_size   = 2
